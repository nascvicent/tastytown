            <bool name="DefinesCapabilities">false</bool>
            <string name="ScriptGuid">{0039705E-DAEE-4295-897A-1C0DA6B104E2}</string>
            <BinaryString name="SerializedOverrides">
            </BinaryString>
            <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RequestSelection = ReplicatedStorage:WaitForChild("Events"):WaitForChild("SelectionEvents"):WaitForChild("RequestCharacterSelection")
local sound = ReplicatedStorage:WaitForChild("Sounds"):WaitForChild("PopSound")
script.Parent.MouseButton1Click:Connect(function()
	sound:Play()

	RequestSelection:FireServer()
end)
]]></string>
            <int64 name="SourceAssetId">-1</int64>
            <BinaryString name="Tags"></BinaryString>
            <UniqueId name="UniqueId">451a84ffcce38a6f097c263c00001939</UniqueId>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="5">
          <Properties>
            <string name="Name">Alinhar</string>
            <BinaryString name="AttributesSerialize"></BinaryString>
            <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
