        <Item class="LocalScript" referent="22">
          <Properties>
            <string name="Name">AcionarLoja</string>
            <BinaryString name="AttributesSerialize"></BinaryString>
            <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
            <bool name="Disabled">false</bool>
            <UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
            <ContentId name="LinkedSource">
              <null>
              </null>
            </ContentId>
            <token name="RunContext">0</token>
            <bool name="DefinesCapabilities">false</bool>
            <string name="ScriptGuid">{29CBBDE7-897E-4F73-9B6E-DEAF16586E47}</string>
            <BinaryString name="SerializedOverrides">
            </BinaryString>
            <string name="Source">local playerGui = game.Players.LocalPlayer:WaitForChild("PlayerGui")
local frame= playerGui:WaitForChild("Lojas"):WaitForChild("ShopGui"):WaitForChild("Frame")
local button = script.Parent

local popSound = game.ReplicatedStorage:WaitForChild("Sounds"):WaitForChild("PopSound")
local TweenService = game:GetService("TweenService")

local isOpen = false

local closeButton = frame:WaitForChild("CloseButton")

--- EFEITOS DE ANIMAÇÃO (TWEEN DO BOTÃO) ---
local scale = button:FindFirstChildOfClass("UIScale") or Instance.new("UIScale", button)
scale.Scale = 1

local tweenInfo = TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
local hoverIn = TweenService:Create(scale, tweenInfo, {Scale = 1.08})
local hoverOut = TweenService:Create(scale, tweenInfo, {Scale = 1})

-- Efeito de hover
button.MouseEnter:Connect(function()
	hoverOut:Cancel()
	hoverIn:Play()
end)

button.MouseLeave:Connect(function()
	hoverIn:Cancel()
	hoverOut:Play()
end)

--- EFEITOS DE CÂMERA (FOV e BLUR) ---
local camera = workspace.CurrentCamera
local originalFOV = camera.FieldOfView

local blur = camera:FindFirstChild("ShopBlur") or Instance.new("BlurEffect")
blur.Name = "ShopBlur"
blur.Size = 0
blur.Enabled = false
blur.Parent = camera

local function tweenFOV(targetFOV)
	local tween = TweenService:Create(camera, tweenInfo, {FieldOfView = targetFOV})
	tween:Play()
end

local function tweenBlur(targetSize)
	blur.Enabled = true
	local tween = TweenService:Create(blur, tweenInfo, {Size = targetSize})
	tween:Play()
	return tween -- Retorna o tween caso precisemos esperar ele terminar
end

--- LÓGICA DE ABRIR/FECHAR (CLIQUE) ---
button.MouseButton1Click:Connect(function()
	popSound:Play()

	-- Inverte o valor (se verdadeiro vira falso, e vice-versa)
	isOpen = not isOpen

	-- Aplica a visibilidade
	frame.Visible = isOpen
	frame.Active = isOpen -- Impede cliques através do frame se necessário

	-- Efeitos visuais
	if isOpen then
		print("Loja aberta")
		tweenFOV(60)         -- Zoom IN (Geralmente diminui o FOV para focar) ou use 80+ para Zoom OUT
		tweenBlur(15)        -- Fundo embaçado
	else
		print("Loja fechada")
		tweenFOV(originalFOV) -- Volta ao FOV original

		local blurTween = tweenBlur(0) -- Remove o blur suavemente

		-- Espera o tween terminar para desativar o efeito totalmente e economizar performance
		blurTween.Completed:Connect(function()
			if not isOpen then -- Confirma se ainda está fechado
				blur.Enabled = false
			end
		end)
	end
end)

closeButton.MouseButton1Click:Connect(function()
	if isOpen then
		popSound:Play()
		isOpen = false
		frame.Visible = false
		frame.Active = false

		print("Loja fechada")
		tweenFOV(originalFOV)
		local blurTween = tweenBlur(0)
		blurTween.Completed:Connect(function()
			if not isOpen then
				blur.Enabled = false
			end
		end)
	end
end)</string>
