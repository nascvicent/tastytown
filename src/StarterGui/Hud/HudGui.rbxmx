            <string name="Source"><![CDATA[local button = script.Parent
button.Size = UDim2.new(0.08, 0, 0.08, 0)

-- Posição: canto inferior direito, com 2% de margem
button.Position = UDim2.new(0.90, 0, 0.35, 0)

-- Âncora no canto inferior direito do botão
button.AnchorPoint = Vector2.new(1, 1)
]]></string>
            <int64 name="SourceAssetId">-1</int64>
            <BinaryString name="Tags"></BinaryString>
            <UniqueId name="UniqueId">451a84ffcce38a6f097c263c0000193a</UniqueId>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="6">
          <Properties>
            <string name="Name">AumentarTamanho</string>
            <BinaryString name="AttributesSerialize"></BinaryString>
            <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
            <bool name="Disabled">false</bool>
            <UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
            <ContentId name="LinkedSource">
              <null>
              </null>
            </ContentId>
            <token name="RunContext">0</token>
            <bool name="DefinesCapabilities">false</bool>
            <string name="ScriptGuid">{9EA44467-8D33-4EB4-8BAE-395FD8460A75}</string>
            <BinaryString name="SerializedOverrides">
            </BinaryString>
            <string name="Source"><![CDATA[-- LocalScript dentro do ImageButton

local button = script.Parent
local tweenService = game:GetService("TweenService")

wait(2)

-- Armazena tamanho original
local originalSize = button.Size

-- Define o quanto vai aumentar (ex: 20% maior)
local scaleFactor = 1.2

-- Calcula o novo tamanho aumentado (manualmente, pois não dá pra multiplicar UDim2 diretamente)
local function getEnlargedSize(size)
	return UDim2.new(
		size.X.Scale * scaleFactor,
		size.X.Offset * scaleFactor,
		size.Y.Scale * scaleFactor,
		size.Y.Offset * scaleFactor
	)
end

local enlargedSize = getEnlargedSize(originalSize)

-- Animação
local tweenInfo = TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

button.MouseEnter:Connect(function()
	local tween = tweenService:Create(button, tweenInfo, {Size = enlargedSize})
	tween:Play()
end)

button.MouseLeave:Connect(function()
	local tween = tweenService:Create(button, tweenInfo, {Size = originalSize})
	tween:Play()
end)
]]></string>
