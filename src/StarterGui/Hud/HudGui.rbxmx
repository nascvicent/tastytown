            <string name="Source">-- LocalScript dentro do botão de toggle do Inventário
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local player = Players.LocalPlayer
local gui = player.PlayerGui:WaitForChild("InventoryGui")
local mainFrame = gui:WaitForChild("MainFrame")
local closeButton = mainFrame:WaitForChild("CloseButton")
local button = script.Parent

local popSound = ReplicatedStorage:WaitForChild("Sounds"):WaitForChild("PopSound")

local isOpen = false

-- ═══════════════════════════════════════════
-- EFEITOS DE ANIMAÇÃO (TWEEN DO BOTÃO)
-- ═══════════════════════════════════════════
local scale = button:FindFirstChildOfClass("UIScale") or Instance.new("UIScale", button)
scale.Scale = 1

local tweenInfo = TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

local hoverIn = TweenService:Create(scale, tweenInfo, {Scale = 1.08})
local hoverOut = TweenService:Create(scale, tweenInfo, {Scale = 1})

button.MouseEnter:Connect(function()
	hoverOut:Cancel()
	hoverIn:Play()
end)

button.MouseLeave:Connect(function()
	hoverIn:Cancel()
	hoverOut:Play()
end)

-- ═══════════════════════════════════════════
-- EFEITOS DE CÂMERA (FOV e BLUR)
-- ═══════════════════════════════════════════
local camera = workspace.CurrentCamera
local originalFOV = camera.FieldOfView

local blur = camera:FindFirstChild("InventoryBlur") or Instance.new("BlurEffect")
blur.Name = "InventoryBlur"
blur.Size = 0
blur.Enabled = false
blur.Parent = camera

local function tweenFOV(targetFOV)
	TweenService:Create(camera, tweenInfo, {FieldOfView = targetFOV}):Play()
end

local function tweenBlur(targetSize)
	blur.Enabled = true
	local tween = TweenService:Create(blur, tweenInfo, {Size = targetSize})
	tween:Play()
	return tween
end

-- ═══════════════════════════════════════════
-- LÓGICA DE ABRIR/FECHAR
-- ═══════════════════════════════════════════
local function updateInventory(state)
	isOpen = state
	gui.Enabled = state
	mainFrame.Visible = state
	mainFrame.Active = state

	if isOpen then
		print("Inventário aberto")
		tweenFOV(60)
		tweenBlur(15)
	else
		print("Inventário fechado")
		tweenFOV(originalFOV)
		local blurTween = tweenBlur(0)
		blurTween.Completed:Connect(function()
			if not isOpen then
				blur.Enabled = false
			end
		end)
	end
end

-- Botão principal (toggle)
button.MouseButton1Click:Connect(function()
	popSound:Play()
	updateInventory(not isOpen)
end)

-- Botão de fechar dentro do frame
closeButton.MouseButton1Click:Connect(function()
	popSound:Play()
	updateInventory(false)
end)</string>
